else
  export NODE_PATH="/Users/gio/Documents/Code/Projects/planomy/node_modules/.pnpm/expo@58.0.21_@babel+core@7.29.7_supports-color@8.1.1__@expo+metro-runtime@58.0.15_expo-_26c92c7cba687cf47f0ea7380f4186f0/node_modules/expo/node_modules:/Users/gio/Documents/Code/Projects/planomy/node_modules/.pnpm/expo@58.0.21_@babel+core@7.29.7_supports-color@8.1.1__@expo+metro-runtime@58.0.15_expo-_26c92c7cba687cf47f0ea7380f4186f0/node_modules:/Users/gio/Documents/Code/Projects/planomy/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../expo/bin/autolinking" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../expo/bin/autolinking" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../expo/bin/autolinking" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../expo/bin/autolinking" "$@"
else
  exec node  "$basedir/../expo/bin/autolinking" "$@"
fi
