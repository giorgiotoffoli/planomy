{
  "expo": {
    "name": "Planomy",
    "slug": "planomy-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "planomy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planomy.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Planomy to use Face ID to unlock your encrypted vault."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "android": {
      "package": "com.planomy.mobile"
    }
  }
}
