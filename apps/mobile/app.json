{
  "expo": {
    "name": "Planomy",
    "slug": "planomy-mobile",
    "icon": "./assets/AppIcon.icon",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "planomy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planomy.app",
      "usesAppleSignIn": true,
      "icon": "./assets/AppIcon.icon",
      "usesNonExemptEncryption": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Planomy to use Face ID to unlock your encrypted vault."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "android": {
      "package": "com.planomy.mobile"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f84c808a-f397-4dbf-8671-397293081049"
      }
    }
  }
}
